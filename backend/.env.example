# Helium backend configuration. Copy to backend/.env and load it from your shell,
# or pass these values directly to Docker Compose / your process manager.

# Runtime
HELIUM_ENV=development
HELIUM_DATA_DIR=./data
HELIUM_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Retrieval and chunking
HELIUM_TOP_K=8
HELIUM_CHUNK_SIZE=512
HELIUM_CHUNK_OVERLAP=64
HELIUM_MAX_CLAIMS=6
HELIUM_MAX_UPLOAD_MB=50
HELIUM_MAX_FILES=50

# Embeddings: auto | sentence-transformers | hash
HELIUM_EMBEDDING_BACKEND=auto
HELIUM_EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
HELIUM_EMBEDDING_DIM=768
HELIUM_EMBEDDING_BATCH_SIZE=32
HELIUM_SPACY_MODEL=en_core_web_sm

# Optional local generation. Disabled by default; extractive answers are used.
HELIUM_ENABLE_LLM=0
HELIUM_LLM_MODEL=microsoft/Phi-3-mini-4k-instruct
HELIUM_LLM_MAX_NEW_TOKENS=512
HELIUM_LLM_TEMPERATURE=0.15
HELIUM_LLM_DEVICE=cpu

# Demo and reviewer defaults
HELIUM_SEED_DEMO=0
HELIUM_DEFAULT_REVIEWER=Compliance Reviewer

# Google OAuth Configuration (for Firebase authentication)
# Get these from Firebase Console > Project Settings > General > Your apps > Web app
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id-here
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret-here
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback/google
